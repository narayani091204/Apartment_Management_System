# API base URL. Leave as /api to use the Vite dev proxy (recommended in dev).
# In production, set to the full backend URL, e.g. https://api.example.com/api
VITE_API_URL=/api

# Socket.io server origin. Leave blank to use the same origin (dev proxy).
# In production, set to the backend origin, e.g. https://api.example.com
VITE_SOCKET_URL=
